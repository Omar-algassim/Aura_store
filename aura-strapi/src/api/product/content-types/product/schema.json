{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "ordered": {
      "type": "biginteger",
      "default": "0"
    },
    "stock": {
      "type": "biginteger",
      "default": "0"
    },
    "usage": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category"
    },
    "brand": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::brand.brand"
    },
    "weight": {
      "type": "integer"
    },
    "color_grade": {
      "type": "string"
    },
    "specification": {
      "type": "text"
    },
    "discount": {
      "type": "decimal"
    },
    "thumbnail": {
      "type": "string",
      "required": true
    },
    "images": {
      "displayName": "images",
      "type": "component",
      "repeatable": true,
      "component": "images.images"
    }
  }
}
